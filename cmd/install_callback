#!/bin/bash
set -e

# 解压 navidrome 到 target 目录
cd "$TRIM_APPDEST"

# 创建数据目录（Navidrome 需要存数据库和配置）
mkdir -p "$TRIM_PKGVAR/data"
mkdir -p "$TRIM_PKGETC"

BASE_SHARE=$(echo "$TRIM_DATA_SHARE_PATHS" | cut -d: -f1)

MUSIC_PATH="${BASE_SHARE}/music"

# 写入默认配置（如果用户还没配置文件）
if [ ! -f "$TRIM_PKGETC/navidrome.toml" ]; then
    cat > "$TRIM_PKGETC/navidrome.toml" <<EOF
MusicFolder = "$MUSIC_PATH"
DataFolder = "$TRIM_PKGVAR/data"
Port = 4533
EOF
fi

exit 0
